# Copy this file to `.env` and fill in the values.
# .env is read by docker compose and passed whole to the Archanist container
# (env_file). The recipes reference these values with ${env.NAME}; the
# travel-rs recipe's `check_env` step fails the update if a required one is
# missing.

# --- Archanist ---

# Absolute host path that `./archanist-data` in docker-compose.yml resolves to.
# The docker daemon resolves bind sources on the host, so the recipes hand this
# path (not /app/data) to sibling containers. Must be absolute.
ARCHANIST_HOST_DATA_DIR=/example/path/to/travel-rs/archanist/archanist-data

# Pin the Archanist image (optional). Defaults to
# ghcr.io/princeofborgo/archanist:latest, pulled on every run so Archanist
# stays current; a pinned tag is only changed by hand.
# ARCHANIST_IMAGE=ghcr.io/princeofborgo/archanist
# ARCHANIST_TAG=v0.1.0

# --- Travel-RS ---

# Active profile file under config/profiles/, without the .toml.
TRAVELRS_PROFILE=your-profile

# Bot token. The swap step injects it into the bot container as TRAVELRS_BOT_TOKEN,
# which the active profile reads via token = "${TRAVELRS_BOT_TOKEN}".
TRAVELRS_BOT_TOKEN=your-telegram-bot-token

# Database connection details for Travel-RS bot. Must match the active profile's [database] section.
# MUST be http:// or https:// - NOT ws://, wss://. The `migrate` step runs
# `surreal export`/`import`, which SurrealDB does not support over WebSocket.
TRAVELRS_DB_ADDRESS=https://your-surreal-endpoint
TRAVELRS_DB_USERNAME=your-db-user
TRAVELRS_DB_PASSWORD=your-db-password
TRAVELRS_DB_NAMESPACE=travel_rs
TRAVELRS_DB_NAME=travel_rs_db
